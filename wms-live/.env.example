# wms-live — environment template (Phase 13 F1 architecture).
# Copy to .env on the Droplet (NEVER commit the real .env).
# Owned by user 'wms', mode 0600.
#
# Architecture: push-based via Postgres LISTEN/NOTIFY.
# Droplet maintains a persistent SSL connection to Supabase Postgres as the
# wms_live_notify_only role (which has NO data privileges — only LISTEN).
# When a row is INSERTed into wms_live_commands, a trigger calls pg_notify,
# Droplet receives the notification and calls wms-live-cmd-poll via HMAC
# to atomically claim + get broker creds.
# Plus a 60s safety-net Edge Function poll for gap recovery after reconnects.

# --- HTTP server ---
PORT=3000

# --- Supabase Edge Functions (HMAC client) ---
SUPABASE_URL=https://lynvrwteylgpwlwbslse.supabase.co
SUPABASE_ANON_KEY=
WMS_LIVE_HMAC_SECRET=

# --- Broker: Fyers (SEBI-compliant -200 App) ---
FYERS_APP_ID=CSEZBR93R3-200

# --- Identification ---
DROPLET_ID=wms-live-1

# --- Postgres LISTEN connection ---
# Get the SESSION POOLER connection from:
#   Supabase Studio → Project Settings → Database → Connection string →
#   "Session pooler" (NOT "Transaction pooler" — transaction pooler breaks LISTEN)
#
# PG_USER format is typically: '<role>.<project-ref>' for the session pooler
# (e.g., 'wms_live_notify_only.lynvrwteylgpwlwbslse'). Verify by looking at
# the connection string Supabase shows; copy the username verbatim.
PG_HOST=
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=
PG_PASSWORD=

# --- Tuning ---
# PG_POLL_SAFETY_NET_MS — NOT READ since 30-Sep-2026. The 60s safety-net poll
# is retired: a pending order older than 2 min is rejected by wms-live-cmd-poll
# (never placed late) and a DB watchdog (mig 132) alerts if orders stop being
# picked up. See backend Documentation/live-infra/ARCHITECTURE.md A.13.4.
# Max backoff between reconnect attempts (exponential up to this cap).
PG_RECONNECT_BACKOFF_MAX_MS=30000

# --- Phase F2: Fyers Order WebSocket + monitoring loop ---
# MONITORING_POLL_BUSY_MS — NOT READ since 30-Sep-2026. Monitoring runs ONE
# cadence, busy or idle (owner decision; fills arrive instantly on the Fyers
# Order WebSocket, this loop is the fallback + token/WS-pool refresh).
# Orders-monitoring cadence (default 5 min):
MONITORING_POLL_IDLE_MS=300000
# Fyers Order WebSocket — usually defaults are fine.
FYERS_ORDER_WS_URL=wss://socket.fyers.in/trade/v3
# How often the Droplet sends the Fyers keep-alive "ping" text message.
FYERS_WS_PING_INTERVAL_MS=10000
# Max backoff between WS reconnect attempts.
FYERS_WS_RECONNECT_BACKOFF_MAX_MS=30000

# ── wms-prices (live-prices feed) — optional ────────────────────────────────
PRICES_HEALTH_PORT=3002
FYERS_WS_LOG_PATH=/tmp

# ── wms-scalp-ws (scalp-engine tick driver) — optional ──────────────────────
# The THIRD independent service: its own Fyers Data socket for scalp contracts,
# pokes the at2-scalp `tick` action on a meaningful move. Separate from
# wms-live (orders) and wms-prices (display feed) by owner design.
#
# CRON_SECRET_KEY authenticates the `tick` call to the at2-scalp Edge Function
# (same key the at2-scalp-scan pg_cron uses). Copy it from Supabase →
# Edge Functions → Secrets (CRON_SECRET_KEY). REQUIRED for this service.
CRON_SECRET_KEY=
SCALP_WS_HEALTH_PORT=3003
# Heartbeat: poke each strategy's `tick` at least this often (ms) even without a
# threshold-sized move — catches a flat/fresh first-buy and slow drifts.
SCALP_WS_HEARTBEAT_MS=20000
